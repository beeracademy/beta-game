{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react"
  ],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "unicorn/no-new-array": "off",
    "react-hooks/exhaustive-deps": "warn",
    "react/set-state-in-effect": "off",
    "react/immutability": "off"
  },
  "env": {
    "builtin": true
  }
}